From 688bbc5b60f68ed15cc2dda1d0933c8eff5428ea Mon Sep 17 00:00:00 2001
From: Justin Suess <utilityemal77@gmail.com>
Date: Mon, 29 Jun 2026 17:34:40 -0400
Subject: [PATCH 03/13] net: stmmac: dwmac-sun8i/sun55i: support a 25 MHz PHY
 clock

Some Allwinner boards feed the external RGMII PHY from an internal 25 MHz
output of the GMAC clock controller instead of an on-board crystal. When
that path is used the clock must be requested and enabled or the PHY
never sees a reference and the link stays down.

Gate this on the "allwinner,use-25m-clk" DT property: when present, grab
and enable the "emac25m" clock during probe/init. dwmac-sun55i handles
the GMAC200 (A523 gmac1); dwmac-sun8i handles the older sun8i/sun50i
EMAC glue (A523 gmac0).
---
 drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c |  8 ++++++++
 drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c  | 11 +++++++++++
 2 files changed, 19 insertions(+)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c
index 862df173d963..59a271986f54 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun55i.c
@@ -108,6 +108,7 @@ static int sun55i_gmac200_probe(struct platform_device *pdev)
 	struct stmmac_resources stmmac_res;
 	struct device *dev = &pdev->dev;
 	struct clk *clk;
+	struct clk *emac_25m_clk;
 	int ret;
 
 	ret = stmmac_get_platform_resources(pdev, &stmmac_res);
@@ -131,6 +132,13 @@ static int sun55i_gmac200_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(clk),
 				     "Failed to get or enable MBUS clock\n");
 
+	if (of_property_read_bool(dev->of_node, "allwinner,use-25m-clk")) {
+		emac_25m_clk = devm_clk_get_enabled(dev, "emac25m");
+		if (IS_ERR(emac_25m_clk))
+			return dev_err_probe(dev, PTR_ERR(emac_25m_clk),
+					     "Failed to get or enable 25M PHY clock\n");
+	}
+
 	ret = devm_regulator_get_enable_optional(dev, "phy");
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to get or enable PHY supply\n");
diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
index 48c52eb96233..381148bb6525 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-sun8i.c
@@ -65,12 +65,14 @@ struct emac_variant {
  */
 struct sunxi_priv_data {
 	struct clk *ephy_clk;
+	struct clk *emac_25m_clk;
 	struct regulator *regulator;
 	struct reset_control *rst_ephy;
 	const struct emac_variant *variant;
 	struct regmap_field *regmap_field;
 	bool internal_phy_powered;
 	bool use_internal_phy;
+	bool use_25m_clk;
 	void *mux_handle;
 };
 
@@ -577,6 +579,12 @@ static int sun8i_dwmac_init(struct device *dev, void *priv)
 	struct sunxi_priv_data *gmac = priv;
 	int ret;
 
+	if (gmac->use_25m_clk) {
+		gmac->emac_25m_clk = devm_clk_get_enabled(dev, "emac25m");
+		if (IS_ERR(gmac->emac_25m_clk))
+			return PTR_ERR(gmac->emac_25m_clk);
+	}
+
 	if (gmac->regulator) {
 		ret = regulator_enable(gmac->regulator);
 		if (ret) {
@@ -1127,6 +1135,9 @@ static int sun8i_dwmac_probe(struct platform_device *pdev)
 		return -EINVAL;
 	}
 
+	if (of_property_read_bool(dev->of_node, "allwinner,use-25m-clk"))
+		gmac->use_25m_clk = true;
+
 	/* Optional regulator for PHY */
 	gmac->regulator = devm_regulator_get_optional(dev, "phy");
 	if (IS_ERR(gmac->regulator)) {
-- 
2.54.0

