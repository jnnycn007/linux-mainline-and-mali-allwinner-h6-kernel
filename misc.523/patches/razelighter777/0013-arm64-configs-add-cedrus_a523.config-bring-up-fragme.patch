From e5cc81f6ef598488a3a45066ad71597e889c8252 Mon Sep 17 00:00:00 2001
From: Justin Suess <utilityemal77@gmail.com>
Date: Mon, 29 Jun 2026 17:40:01 -0400
Subject: [PATCH 13/13] arm64: configs: add cedrus_a523.config bring-up
 fragment

Add a config fragment to merge over the arm64 defconfig for A523/H728
bring-up: SoC core (CCU, pinctrl, SRAM, SID), UART console, the sunxi
watchdog built-in so it disarms U-Boot's timer, eMMC, the gmac1 ethernet
(STMMAC + DWMAC_SUN55I), the AXP2202 PMIC/regulators, the media stack
with the Cedrus VPU, a CMA pool for decode buffers, and the DE33 ->
DW-HDMI display pipeline. Usage and the non-obvious gotchas are
documented inline in the fragment.
---
 arch/arm64/configs/cedrus_a523.config | 88 +++++++++++++++++++++++++++
 1 file changed, 88 insertions(+)
 create mode 100644 arch/arm64/configs/cedrus_a523.config

diff --git a/arch/arm64/configs/cedrus_a523.config b/arch/arm64/configs/cedrus_a523.config
new file mode 100644
index 000000000000..9c52b15eedb8
--- /dev/null
+++ b/arch/arm64/configs/cedrus_a523.config
@@ -0,0 +1,88 @@
+# Minimal A523 (sun55iw3) bring-up fragment for testing cedrus on mainline.
+# Merge over the arm64 defconfig:
+#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- defconfig cedrus_a523.config
+#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
+#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- Image dtbs -j$(nproc)
+# DTB: arch/arm64/boot/dts/allwinner/sun55i-a523.dtb (built from your board .dts).
+
+CONFIG_ARCH_SUNXI=y
+
+# --- SoC core: clocks, resets, pinctrl, SID ---
+CONFIG_SUN55I_A523_CCU=y
+CONFIG_SUN55I_A523_R_CCU=y
+CONFIG_PINCTRL_SUN55I_A523=y
+CONFIG_RESET_CONTROLLER=y
+CONFIG_NVMEM_SUNXI_SID=y
+CONFIG_SUNXI_SRAM=y
+
+# --- Console: UART0 @0x02500000 (earlycon=uart8250,mmio32,0x02500000) ---
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_8250_DW=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_SERIAL_EARLYCON=y
+
+# --- Watchdog: U-Boot arms the sunxi WDT (16s) and hands off to the OS.
+# Build the driver in (=y, not =m) so it probes early and disarms the
+# timer (sunxi_wdt_probe -> sunxi_wdt_stop); as a module it never loads
+# without an initramfs and the board resets ~16s into boot.
+CONFIG_WATCHDOG=y
+CONFIG_SUNXI_WATCHDOG=y
+
+# --- Root storage: eMMC (root=/dev/mmcblk0pN) ---
+CONFIG_MMC=y
+CONFIG_MMC_BLOCK=y
+CONFIG_MMC_SUNXI=y
+
+# --- Ethernet: gmac1 (4510000.ethernet) = sun55i-a523-gmac200 / dwmac-4.20a.
+# The arm64 default config leaves STMMAC off, so the MAC never binds and the
+# board logs "sync_state() pending due to 4510000.ethernet" with no probe.
+# DWMAC_SUN55I is the glue for the A523 GMAC200; STMMAC_ETH pulls in PHYLIB
+# (genphy brings the RGMII link up; MAC-side tx/rx-internal-delay-ps handle the
+# delays). Add the specific PHY driver once the MDIO scan reports the PHY ID.
+CONFIG_STMMAC_ETH=y
+CONFIG_STMMAC_PLATFORM=y
+CONFIG_DWMAC_SUN55I=y
+
+# --- PMIC (AXP2202 on RSB) + regulators ---
+CONFIG_SUNXI_RSB=y
+CONFIG_MFD_AXP20X=y
+CONFIG_MFD_AXP20X_RSB=y
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_REGULATOR_AXP20X=y
+
+# --- Media stack + Cedrus VPU (the thing under test) ---
+CONFIG_MEDIA_SUPPORT=y
+CONFIG_MEDIA_CONTROLLER=y
+CONFIG_MEDIA_PLATFORM_SUPPORT=y
+CONFIG_V4L_MEM2MEM_DRIVERS=y
+CONFIG_VIDEO_DEV=y
+CONFIG_STAGING=y
+CONFIG_STAGING_MEDIA=y
+# VIDEO_SUNXI is the menu gate (drivers/staging/media/sunxi/Kconfig: `if VIDEO_SUNXI`)
+# that the cedrus symbol lives under. Without it, olddefconfig silently drops
+# CONFIG_VIDEO_SUNXI_CEDRUS even though all its `depends on` are satisfied.
+CONFIG_VIDEO_SUNXI=y
+CONFIG_VIDEO_SUNXI_CEDRUS=y
+
+# --- CMA pool for decode buffers (no IOMMU path; VE does physical DMA) ---
+CONFIG_CMA=y
+CONFIG_DMA_CMA=y
+CONFIG_CMA_SIZE_MBYTES=256
+
+# --- DRM display pipeline: DE33 mixer -> TCON-TOP -> TCON-TV -> DW-HDMI ->
+# Inno HDMI PHY. Built-in (=y) so the component framework assembles the
+# whole pipeline at boot without module-load ordering issues. (HDMI bring-up.)
+CONFIG_DRM=y
+CONFIG_DRM_SUN4I=y
+CONFIG_DRM_SUN8I_MIXER=y
+CONFIG_DRM_SUN8I_TCON_TOP=y
+CONFIG_DRM_DW_HDMI=y
+CONFIG_DRM_SUN8I_DW_HDMI=y
+
+# --- Rootfs conveniences ---
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_EXT4_FS=y
+CONFIG_F2FS_FS=y
-- 
